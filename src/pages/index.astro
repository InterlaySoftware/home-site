---
import GoogleTag from "../components/GoogleTag.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../data/site";
import "../styles/global.css";

const canonicalUrl = new URL("/", site.url).toString();
const siteLogoUrl = new URL(site.logoPath, site.url).toString();
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Nikolas Padilla",
  url: site.url,
  email: site.email,
  jobTitle: "Software developer",
  worksFor: {
    "@type": "Organization",
    name: site.name,
    url: site.url,
    logo: siteLogoUrl,
    sameAs: [site.googleBusinessProfileUrl],
  },
  address: { "@type": "PostalAddress", addressLocality: "Phoenix", addressRegion: "AZ" },
};

const fieldScreens = [
  {
    image: "/work/field-work-order.jpg",
    alt: "A work order in the ServiceComply field app, showing progress and the water purveyor for the job.",
    caption: "The office sends the tech a link. The whole job lands on their phone.",
  },
  {
    image: "/work/field-device.jpg",
    alt: "Assembly details in the ServiceComply field app: a repaired result, access notes, and the on-site location.",
    caption: "Results, repairs, and access notes get recorded on site, even without signal.",
  },
];

const websites = [
  {
    name: "AnyBackFlow",
    what: "Backflow testing and repair, Phoenix",
    built: "Service pages, hydrant testing, and a quote form that goes straight to the office inbox.",
    href: "https://anybackflow.com",
    domain: "anybackflow.com",
    image: "/work/abf.jpg",
  },
  {
    name: "AMK Mechanical",
    what: "Evaporative cooler service, Glendale",
    built: "Quote form with photo uploads, a project gallery, and pages built around how people search.",
    href: "https://amk-mechanical.com",
    domain: "amk-mechanical.com",
    image: "/work/amk.jpg",
  },
];
---

<!doctype html>
<html lang="en" class="bg-paper text-ink">
  <head>
    <GoogleTag />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={site.logoPath} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="theme-color" content="#17202c" />
    <link rel="preload" href="/fonts/bitter/bitter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/hanken-grotesk/hanken-grotesk-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body class="min-h-screen overflow-x-hidden bg-paper font-sans text-[1.0625rem] leading-7 antialiased">
    <header class="mx-auto flex max-w-[1180px] items-center justify-between gap-4 px-5 py-5 sm:px-8">
      <a href="/" class="leading-tight">
        <span class="display block text-lg">Nikolas Padilla</span>
        <span class="block text-sm text-graphite">Interlay Software</span>
      </a>
      <nav class="flex items-center gap-6 text-[0.95rem] font-semibold" aria-label="Site">
        <a class="hidden hover:text-pen sm:inline" href="#work">Work</a>
        <a class="hidden hover:text-pen sm:inline" href="#about">About</a>
        <a class="rounded-md bg-ink px-4 py-2.5 text-white transition-colors hover:bg-pen" href={`mailto:${site.email}`}
          >Email me</a
        >
      </nav>
    </header>

    <main>
      <section class="mx-auto max-w-[1180px] px-5 pt-12 pb-20 sm:px-8 sm:pt-20 lg:pb-28">
        <div class="flex items-center gap-4">
          <img
            src="/work/nikolas.jpg"
            alt="Nikolas Padilla"
            width="64"
            height="64"
            class="size-16 rounded-full object-cover"
          />
          <p class="text-graphite">Software developer in Phoenix, Arizona</p>
        </div>
        <h1 class="display mt-8 max-w-[19ch] text-[2.6rem] leading-[1.02] sm:text-[4.2rem] lg:text-[5rem]">
          My family runs a backflow company. I wrote the software it runs on.
        </h1>
        <p class="mt-8 max-w-[56ch] text-lg leading-8 text-graphite sm:text-xl sm:leading-9">
          I'm Nikolas. I build websites, online stores, and custom tools for trade and service businesses, the kind of
          work I grew up around. If your office runs on spreadsheets, paper forms, or a website nobody can update,
          that's what I fix.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a
            class="rounded-md bg-ink px-6 py-4 font-semibold text-white transition-colors hover:bg-pen"
            href={`mailto:${site.email}`}>Email me about your business</a
          >
          <a class="pen-link" href="#work">See what I've built</a>
        </div>
      </section>

      <section id="work" class="scroll-mt-4 border-t border-line bg-concrete">
        <div class="mx-auto max-w-[1180px] px-5 py-20 sm:px-8 lg:py-28">
          <div class="grid gap-14 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16">
            <div>
              <h2 class="display text-[2.2rem] leading-tight sm:text-5xl">ServiceComply</h2>
              <p class="mt-2 text-lg font-semibold">
                Backflow testing software, from the office to the field to the city.
              </p>
              <div class="mt-6 space-y-5 text-graphite">
                <p>
                  The office schedules the job. The tech runs the test on an Android app. ServiceComply checks the
                  readings and fills in the report the water authority expects, ready to file.
                </p>
                <p>
                  I built it for our own company first, to get rid of paper test forms, spreadsheet trackers, and
                  retyping results for the city. Now other testing companies can use it too.
                </p>
              </div>
              <dl class="mt-8 grid gap-4 border-t border-line pt-6 text-[0.95rem]">
                <div class="grid grid-cols-[7rem_1fr] gap-3">
                  <dt class="text-graphite">What I built</dt>
                  <dd>Office web app, Android field app, and the server behind both</dd>
                </div>
                <div class="grid grid-cols-[7rem_1fr] gap-3">
                  <dt class="text-graphite">Used by</dt>
                  <dd>AnyBackFlow, every day</dd>
                </div>
                <div class="grid grid-cols-[7rem_1fr] gap-3">
                  <dt class="text-graphite">See it</dt>
                  <dd><a class="pen-link" href="https://servicecomply.com">servicecomply.com</a></dd>
                </div>
              </dl>
            </div>

            <figure class="grid grid-cols-2 gap-4 sm:gap-6 lg:pt-2">
              {
                fieldScreens.map((screen, index) => (
                  <div class={index === 1 ? "pt-16 sm:pt-24" : ""}>
                    <img
                      src={screen.image}
                      alt={screen.alt}
                      width="540"
                      height="960"
                      class="block h-auto w-full rounded-[1.4rem] border-[6px] border-ink bg-ink shadow-[0_30px_60px_-30px_rgb(23_32_44/0.5)]"
                      loading="lazy"
                    />
                    <p class="mt-4 text-[0.95rem] leading-6">{screen.caption}</p>
                  </div>
                ))
              }
              <figcaption class="col-span-2 text-sm text-graphite">
                ServiceComply's Android field app, with test data.
              </figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section class="border-t border-line bg-paper">
        <div
          class="mx-auto grid max-w-[1180px] gap-12 px-5 py-20 sm:px-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:gap-16 lg:py-28"
        >
          <figure class="order-2 lg:order-1">
            <a href="https://backflow.medusajs.site" class="block overflow-hidden rounded-md border border-line">
              <img
                src="/work/medusa.jpg"
                alt="The new Backflow Parts Supplier store: search by part number, shop by category, pickup in Phoenix."
                width="1200"
                height="750"
                class="block h-auto w-full"
                loading="lazy"
              />
            </a>
          </figure>
          <div class="order-1 lg:order-2">
            <h2 class="display text-[2.2rem] leading-tight sm:text-5xl">Backflow Parts Supplier</h2>
            <p class="mt-2 text-lg font-semibold">A parts store testers can search by assembly.</p>
            <div class="mt-6 space-y-5 text-graphite">
              <p>
                I built their Shopify store first. It worked, until contractors needed their own pricing and the counter
                needed to know what was actually on the shelf.
              </p>
              <p>
                So I built a custom store to replace it, launching next month. Contractor accounts see their own prices,
                the cart checks live warehouse stock, and orders are ready for pickup.
              </p>
            </div>
            <ul class="mt-8 grid gap-2 border-t border-line pt-6">
              <li><a class="pen-link" href="https://backflow.medusajs.site">Preview the new store</a></li>
              <li><a class="pen-link" href="https://www.getbackflowparts.com">The current Shopify store</a></li>
            </ul>
          </div>
        </div>
      </section>

      <section class="border-t border-line bg-paper">
        <div class="mx-auto max-w-[1180px] px-5 pt-16 pb-20 sm:px-8 lg:pt-20 lg:pb-28">
          <h2 class="display max-w-[22ch] text-[2rem] leading-tight sm:text-4xl">
            And websites for the businesses I work with.
          </h2>
          <div class="mt-10 grid gap-12 md:grid-cols-2 md:gap-10">
            {
              websites.map((item) => (
                <article>
                  <a href={item.href} class="block overflow-hidden rounded-md border border-line">
                    <img
                      src={item.image}
                      alt={`The ${item.name} website homepage`}
                      width="1200"
                      height="750"
                      class="block h-auto w-full"
                      loading="lazy"
                    />
                  </a>
                  <h3 class="mt-5 text-xl font-bold">{item.name}</h3>
                  <p class="text-graphite">{item.what}</p>
                  <p class="mt-3">{item.built}</p>
                  <a class="pen-link mt-3 inline-block" href={item.href}>
                    {item.domain}
                  </a>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="about" class="scroll-mt-4 border-t border-line bg-paper">
        <div
          class="mx-auto grid max-w-[1180px] gap-10 px-5 py-20 sm:px-8 md:grid-cols-[240px_minmax(0,1fr)] lg:gap-16 lg:py-28"
        >
          <img
            src="/work/nikolas.jpg"
            alt="Nikolas Padilla"
            width="400"
            height="400"
            class="w-40 rounded-md object-cover md:w-full"
            loading="lazy"
          />
          <div class="max-w-[62ch]">
            <h2 class="display text-[2rem] leading-tight sm:text-4xl">Working with me</h2>
            <div class="mt-6 space-y-5 text-lg leading-8 text-graphite">
              <p>
                You talk to me, not an account manager. I'll look at how your business actually runs, tell you what I'd
                fix first, what it costs, and what you can skip.
              </p>
              <p>
                Sometimes that's a better website and quote form. Sometimes it's a small tool that replaces a
                spreadsheet three people keep fighting over. Sometimes it's something as big as ServiceComply. Either
                way, I stick around after launch to keep it running.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section id="contact" class="bg-ink text-white">
        <div class="mx-auto max-w-[1180px] px-5 pt-20 pb-16 sm:px-8 lg:pt-28">
          <h2 class="display max-w-[18ch] text-[2.4rem] leading-[1.05] sm:text-6xl">
            Tell me what's slowing your business down.
          </h2>
          <p class="mt-6 max-w-[52ch] text-lg text-white/70">
            A few sentences is plenty: what you do, what tools you use now, and what keeps going wrong.
          </p>
          <a
            class="display mt-10 inline-block text-[1.35rem] break-all text-white underline decoration-marker decoration-[3px] underline-offset-[0.25em] hover:decoration-white sm:text-4xl"
            href={`mailto:${site.email}`}>{site.email}</a
          >
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
