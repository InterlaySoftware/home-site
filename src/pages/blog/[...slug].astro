---
import { Check, Link } from "@lucide/astro";
import { getCollection, render } from "astro:content";
import GoogleTag from "../../components/GoogleTag.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { site } from "../../data/site";
import "../../styles/global.css";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((post) => !post.data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const canonicalUrl = new URL(`/blog/${post.id}/`, site.url).toString();
const pageTitle = `${post.data.title} | ${site.name}`;
const publishedTime = `${post.data.date}T00:00:00.000Z`;
const formattedDate = new Date(publishedTime).toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const sectionHeadings = headings.filter((heading) => heading.depth === 2);
const takeaways = post.data.takeaways;
---

<!doctype html>
<html lang="en" class="bg-paper text-ink">
  <head>
    <GoogleTag />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={post.data.description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={site.logoPath} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={post.data.title} />
    <meta property="og:description" content={post.data.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="article:published_time" content={publishedTime} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="min-h-screen bg-paper font-sans antialiased">
    <header class="border-b border-line bg-white">
      <div class="mx-auto flex h-[68px] max-w-[1240px] items-center justify-between px-5 sm:px-8">
        <a href="/" class="flex min-w-0 items-center gap-3" aria-label="Interlay Software home">
          <img src="/favicon.svg" alt="" class="size-10 shrink-0 rounded-lg" aria-hidden="true" />
          <span class="truncate text-lg font-extrabold text-ink sm:text-xl">Interlay Software</span>
        </a>
        <nav class="flex h-full items-center gap-7 text-sm font-bold text-body sm:text-base" aria-label="Site">
          <a class="flex h-full items-center border-b-2 border-transparent transition hover:text-teal-dark" href="/">
            Home
          </a>
          <a
            class="flex h-full items-center border-b-2 border-teal-dark text-teal-dark"
            href="/blog/"
            aria-current="page"
          >
            Blog
          </a>
        </nav>
      </div>
    </header>

    <main
      class="mx-auto grid max-w-[1240px] gap-12 px-5 py-8 sm:px-8 lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-14 lg:py-10"
    >
      <article class="min-w-0">
        <nav class="flex flex-wrap items-center gap-4 text-sm font-medium" aria-label="Breadcrumb">
          <a class="font-bold text-teal-dark transition hover:text-ink" href="/blog/">Blog</a>
          <span class="text-muted">/</span>
          <span class="text-ink">{post.data.title}</span>
        </nav>

        <header class="mt-9 max-w-[820px]">
          <div class="flex flex-wrap items-center gap-3">
            <time class="text-base font-medium text-ink" datetime={post.data.date}>{formattedDate}</time>
            <span class="h-5 w-px bg-line" aria-hidden="true"></span>
            {
              post.data.topics.map((topic) => (
                <span class="rounded bg-panel-soft px-2.5 py-1 text-sm font-medium text-body">{topic}</span>
              ))
            }
          </div>
          <h1 class="mt-5 text-[2.65rem] leading-[1.04] font-black text-ink sm:text-[4rem]">{post.data.title}</h1>
          <p class="mt-5 max-w-[720px] text-lg leading-8 text-body">{post.data.description}</p>
        </header>

        <div class="article-prose mt-9 border-t border-line pt-7">
          <Content />
        </div>
      </article>

      <aside class="hidden lg:block">
        <div class="sticky top-24 grid gap-10 border-l border-line pl-9">
          <div class="grid gap-4 pt-6 text-sm font-medium text-ink">
            <button
              class="inline-flex w-fit items-center gap-2 rounded px-1.5 py-1 text-left transition hover:bg-teal-soft/60 hover:text-teal-dark active:scale-[0.98]"
              type="button"
              data-copy-link
            >
              <Link class="size-5 text-teal-dark" aria-hidden="true" />
              Copy link
            </button>
          </div>

          {
            sectionHeadings.length > 0 && (
              <div class="border-t border-line pt-5">
                <h2 class="text-base font-black text-teal-dark">Contents</h2>
                <nav class="mt-3 divide-y divide-line text-sm font-medium" aria-label="Article sections">
                  {sectionHeadings.map((heading) => (
                    <a class="contents-link block py-3 transition hover:text-ink" href={`#${heading.slug}`}>
                      {heading.text}
                    </a>
                  ))}
                </nav>
              </div>
            )
          }

          {
            takeaways.length > 0 && (
              <section class="rounded-md border border-line bg-teal-soft/35 p-5 shadow-[0_16px_40px_rgba(16,24,32,0.06)]">
                <h2 class="text-lg font-black text-teal-dark">Key takeaways</h2>
                <ul class="mt-4 grid gap-4 text-sm leading-5 text-body">
                  {takeaways.map((takeaway) => (
                    <li class="grid grid-cols-[1.25rem_1fr] gap-3">
                      <Check class="mt-0.5 size-4 text-teal-dark" aria-hidden="true" />
                      <span>{takeaway}</span>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }
        </div>
      </aside>
    </main>

    <SiteFooter anchorPrefix="/" />

    <script>
      const showCopiedMessage = (event: MouseEvent) => {
        const message = document.createElement("span");
        message.className = "copied-pop";
        message.textContent = "Copied";
        message.style.left = `${event.clientX}px`;
        message.style.top = `${event.clientY}px`;
        document.body.append(message);
        message.addEventListener("animationend", () => message.remove(), { once: true });
      };

      document.querySelectorAll("button").forEach((button) => {
        if (button.hasAttribute("data-copy-link")) {
          button.addEventListener("click", async (event) => {
            const url = new URL(window.location.href);
            url.hash = "";
            await navigator.clipboard?.writeText(url.toString());
            showCopiedMessage(event);
          });
        }
      });
    </script>
  </body>
</html>
